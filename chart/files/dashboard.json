{
 "uid": "credshield",
 "title": "Выдача учётных данных: состояние подсистемы",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Остаток срока аренды",
   "description": "Остаток срока действующей аренды у агента; пилообразный график — замены на 2/3 срока",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "credshield_agent_lease_remaining_seconds",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Файл учётных данных присутствует",
   "description": "1 — файл есть, 0 — файл удалён по истечении срока (закрытый отказ)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "credshield_agent_file_present",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Выдачи агента, в минуту",
   "description": "Попытки получить учётные данные: успешные и с ошибкой",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(credshield_agent_issues_total[1m]))*60",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Задержка выдачи (вход и получение данных)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(credshield_agent_issue_duration_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(credshield_agent_issue_duration_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "События агента: повторы, замены, удаление файла",
   "description": "Число событий за минуту",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (event) (increase(credshield_agent_events_total{event=~\"retry|replaced|expiring_soon|expired_removed\"}[1m]))",
     "legendFormat": "{{event}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Запросы микросервисов к СУБД, в секунду",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service, result) (rate(credshield_app_queries_total[30s]))",
     "legendFormat": "{{service}} / {{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Обращения по журналу аудита, в минуту",
   "description": "Разрешённые и отклонённые обращения к учётным данным",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (role, result) (rate(credshield_responder_events_total[1m]))*60",
     "legendFormat": "{{role}} / {{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Решения детектора и отзывы",
   "description": "Накопленные значения счётчиков",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (reason) (credshield_responder_decisions_total)",
     "legendFormat": "решение: {{reason}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (credshield_responder_revocations_total)",
     "legendFormat": "отзыв: {{result}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "CPU контейнеров, ядер",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"credshield\",container!=\"\",container!=\"POD\"}[30s]))",
     "legendFormat": "{{container}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Память контейнеров (working set)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"credshield\",container!=\"\",container!=\"POD\"})",
     "legendFormat": "{{container}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Перезапуски контейнеров за 5 минут",
   "description": "Изменения времени запуска контейнера — признак перезапуска",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container) (changes(container_start_time_seconds{namespace=\"credshield\",container!=\"\",container!=\"POD\"}[5m]))",
     "legendFormat": "{{container}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Активные оповещения",
   "description": "Правила Prometheus: замена не удаётся, срок на исходе, отзыв и др.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "legendFormat": "{{alertname}} ({{severity}})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Нагрузочный замер: запросов в секунду",
   "description": "Выдачи учётных данных клиентом нагрузки",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(credshield_bench_requests_total[10s]))",
     "legendFormat": "{{result}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(credshield_bench_target_rate)",
     "legendFormat": "задано",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
